NODE_ENV=production
DATABASE_CLIENT=postgres
HOST=0.0.0.0
PORT=1337
PUBLIC_URL=https://your-app-name.ondigitalocean.app
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# DigitalOcean Spaces (omit DO_SPACE_BUCKET to use local storage in development)
DO_SPACE_BUCKET=timber-store
DO_SPACE_REGION=ams3
DO_SPACE_ENDPOINT=https://ams3.digitaloceanspaces.com
DO_SPACE_CDN_URL=https://timber-store.ams3.cdn.digitaloceanspaces.com
DO_SPACE_ROOT_PATH=strapi
DO_SPACE_ACCESS_KEY_ID=replace-with-a-spaces-key
DO_SPACE_SECRET_ACCESS_KEY=replace-with-a-spaces-secret
DO_SPACE_ACL=public-read
DO_SPACE_CACHE_CONTROL=public, max-age=31536000, immutable
